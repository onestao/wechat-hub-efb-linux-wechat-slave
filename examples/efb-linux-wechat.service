[Unit]
Description=EH Forwarder Bot - Linux WeChat Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wechat-hub
Group=wechat-hub
WorkingDirectory=/opt/wechat-hub/work/efb-linux-wechat-slave
Environment=HOME=/var/lib/wechat-hub
Environment=PYTHONUTF8=1
ExecStart=/opt/wechat-hub/work/efb-linux-wechat-slave/.venv/bin/ehforwarderbot -p default
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
